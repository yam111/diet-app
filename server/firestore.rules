rules_version = '2';
// 食光 共用食物庫（Firebase 專案 shiguang-d673f，Firestore 規則；在 Firebase 控制台 → Firestore → 規則 貼上後發布）
// 每筆一個文件：foods/b<條碼> 或 foods/n<品名短碼>，內容 { r: [條碼, 品名, 每份克, 液體, 每100熱量, 蛋白質, 碳水, 脂肪, 糖, 鈉, 飽和, 反式, 纖維], t: 時間 }
// 誰都能讀；寫入要數字在範圍內（熱量跟三大營養素不用對得起來：喉糖糖醇、纖維會不一樣）（跟 Apps Script 版 clean_ 同一套檢查）；不能真的刪；App 裡刪除（輸入錯誤、重複）是寫 d: true 標成已刪除，大家的 App 就不顯示（有人亂填也可以在控制台刪那筆）
service cloud.firestore {
  match /databases/{database}/documents {
    function num(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function nx(v, hi) { return v == null || num(v, 0, hi); }
    function okRow(id, r) {
      return r is list && r.size() == 13
        && r[0] is string && r[0].matches('^([0-9]{8,14})?$')
        && ((r[0] != '' && id == 'b' + r[0]) || (r[0] == '' && id.matches('^n[0-9a-z]{1,8}$')))
        && r[1] is string && r[1].size() >= 1 && r[1].size() <= 40
        && num(r[2], 1, 3000) && (r[3] == 0 || r[3] == 1 || r[3] == 2)
        && num(r[4], 0, 950) && num(r[5], 0, 100) && num(r[6], 0, 100) && num(r[7], 0, 100)
        && r[5] + r[6] + r[7] <= 100.5
        && nx(r[8], 100) && nx(r[9], 40000) && nx(r[10], 100) && nx(r[11], 100) && nx(r[12], 100);
    }
    match /foods/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['r', 't', 'd'])
        && (!('d' in request.resource.data) || request.resource.data.d == true)
        && request.resource.data.t == request.time
        && okRow(id, request.resource.data.r);
      allow delete: if false;
    }
    // 連結健身 App：link/<10 碼連結碼>，內容 { j: 每日總熱量／三大營養素、體重、目標的 JSON 字串, t: 時間 }。知道碼才讀得到（不能列出全部）
    match /link/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if code.matches('^[A-Z0-9]{10}$')
        && request.resource.data.keys().hasOnly(['j', 't'])
        && request.resource.data.j is string && request.resource.data.j.size() <= 20000
        && request.resource.data.t == request.time;
      allow delete: if true;
    }
  }
}
